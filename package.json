{
  "name": "vibes-dlc",
  "version": "0.1.0",
  "private": true,
  "description": "Guia local, em português, que conduz uma pessoa pelo AI-DLC, com um terminal real ao lado.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . && prettier --check --no-error-on-unmatched-pattern src scripts migrations \"*.{ts,mjs,json}\"",
    "format": "prettier --write --no-error-on-unmatched-pattern src scripts\"*.{ts,mjs,json}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "verify": "npm run check"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "next": "^16.4.4",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1"
  }
}
